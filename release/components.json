    },
    {
      "name": "image:opensandbox/egress",
      "kind": "docker-image",
      "roles": [
        "hermes-execution"
      ],
      "inputs": [
        "sources.json",
        "deployment/b/opensandbox.toml.example"
      ],
      "image": "opensandbox/egress",
      "source_keys": {
        "current": [
          "images",
          "opensandbox/egress",
          "tag"
        ],
        "digest": [
          "images",
          "opensandbox/egress",
          "index_digest"
        ],
        "amd64_digest": [
          "images",
          "opensandbox/egress",
          "amd64_digest"
        ]
      }
    },
    {
      "name": "docker-sdk",
      "kind": "github-file",
      "roles": [
        "hermes-execution"
      ],
      "inputs": [
        "sources.json",
        "deployment/b/workshop.yaml.example"
      ],
      "repository": "canonical/docker-sdk",
      "ref": "latest",
      "file": "VERSION",
      "qualification": "Discovery watches the publisher track; published Store revision/base must be verified with sdk info docker-ce during qualification. A track change is not proof of publication.",
      "source_keys": {
        "current": [
          "docker_sdk",
          "version"
        ]
      }
    },
    {
      "name": "docker-engine",
      "kind": "docker-apt",
