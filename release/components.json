{
  "schema_version": 1,
  "local_parts": [
    "hermes-experiment/services",
    "hermes-experiment/integration-assets",
    "hermes-execution/services",
    "hermes-execution/assets",
    "hermes-rea/assets"
  ],
  "lock_parts": [
    "stripe-link-cli/link-cli",
    "hermes-experiment/hindsight-runtime"
  ],
  "components": [
    {
      "name": "hermes",
      "kind": "github-release",
      "roles": [
        "hermes-experiment"
      ],
      "inputs": [
        "sources.json"
      ],
      "repository": "NousResearch/hermes-agent",
      "pattern": "v(\\d{1,3}\\.\\d+\\.\\d+)",
      "parts": [
        "hermes-experiment/hermes-agent"
      ],
      "chronological": true,
      "source_keys": {
        "current": [
          "hermes",
          "tag"
        ],
        "revision": [
          "hermes_commit"
        ]
      }
    },
    {
      "name": "opensandbox",
      "kind": "github-release",
      "roles": [
        "hermes-experiment",
        "hermes-execution"
      ],
      "inputs": [
        "sources.json"
      ],
      "repository": "opensandbox-group/OpenSandbox",
      "pattern": "release-(\\d+\\.\\d+\\.\\d+)",
      "parts": [
        "hermes-execution/opensandbox"
      ],
      "source_keys": {
        "current": [
          "opensandbox",
          "tag"
        ],
        "revision": [
          "opensandbox",
          "commit"
        ]
      }
    },
    {
      "name": "cloudflared",
      "kind": "github-release",
      "roles": [
        "hermes-execution"
      ],
      "inputs": [
        "sources.json"
      ],
      "repository": "cloudflare/cloudflared",
      "pattern": "(\\d+\\.\\d+\\.\\d+)",
      "parts": [
        "hermes-execution/cloudflared"
      ],
      "source_keys": {
        "current": [
          "cloudflared",
          "tag"
        ]
      }
    },
    {
      "name": "buzz",
      "kind": "github-release",
      "roles": [
        "hermes-experiment"
      ],
      "inputs": [
        "sources.json"
      ],
      "repository": "block/buzz",
      "pattern": "desktop-v(\\d+\\.\\d+\\.\\d+)",
      "parts": [
        "hermes-experiment/buzz-cli"
      ],
      "source_keys": {
        "current": [
          "buzz",
          "tag"
        ],
        "revision": [
          "buzz",
          "commit"
        ]
      }
    },
    {
      "name": "sui",
      "kind": "github-release",
      "roles": [
        "sui-cli"
      ],
      "inputs": [
        "sources.json"
      ],
      "repository": "MystenLabs/sui",
      "pattern": "mainnet-v(\\d+\\.\\d+\\.\\d+)",
      "parts": [
        "sui-cli/sui"
      ],
      "source_keys": {
        "current": [
          "sui",
          "tag"
        ]
      }
    },
    {
      "name": "ghidra",
      "kind": "github-release",
      "roles": [
        "hermes-rea"
      ],
      "inputs": [
        "sources.json"
      ],
      "repository": "NationalSecurityAgency/ghidra",
      "pattern": "Ghidra_(\\d+\\.\\d+\\.\\d+)_build",
      "parts": [
        "hermes-rea/ghidra"
      ],
      "compatibility": "REA 6.7.0 requires Ghidra 12.1.x; newer lines require coordinated REA qualification.",
      "source_keys": {
        "current": [
          "ghidra",
          "tag"
        ]
      }
    },
    {
      "name": "frida",
      "kind": "github-release",
      "roles": [
        "hermes-rea"
      ],
      "inputs": [
        "sources.json"
      ],
      "repository": "frida/frida",
      "pattern": "(\\d+\\.\\d+\\.\\d+)",
      "parts": [
        "hermes-rea/frida-native"
      ],
      "source_keys": {
        "current": [
          "frida_native",
          "version"
        ]
      },
      "release_page_size": 10
    },
    {
      "name": "node",
      "kind": "node",
      "roles": [
        "hermes-experiment",
        "hermes-rea",
        "stripe-link-cli"
      ],
      "inputs": [
        "sources.json"
      ],
      "parts": [
        "hermes-experiment/node-runtime",
        "hermes-rea/node-runtime",
        "stripe-link-cli/node-runtime"
      ],
      "source_keys": {
        "current": [
          "node",
          "version"
        ]
      }
    },
    {
      "name": "python",
      "kind": "github-tags",
      "roles": [
        "hermes-experiment",
        "hermes-execution"
      ],
      "inputs": [
        "sources.json"
      ],
      "repository": "python/cpython",
      "pattern": "v(\\d+\\.\\d+\\.\\d+)",
      "compatibility": "Python ABI changes require rebuilding every wheel and checking all plugin locks.",
      "source_keys": {
        "current": [
          "hindsight_runtime",
          "python"
        ]
      }
    },
    {
      "name": "rea",
      "kind": "npm",
      "roles": [
        "hermes-rea"
      ],
      "inputs": [
        "sources.json"
      ],
      "package": "rea-agents",
      "parts": [
        "hermes-rea/rea"
      ],
      "source_keys": {
        "current": [
          "rea",
          "version"
        ]
      }
    },
    {
      "name": "plugin:hindsight",
      "kind": "hermes-catalog",
      "roles": [
        "hermes-experiment"
      ],
      "inputs": [
        "sources.json"
      ],
      "catalog": "hindsight",
      "repository": "vectorize-io/hindsight",
      "subdir": "hindsight-integrations/hermes",
      "parts": [
        "hermes-experiment/official-plugins"
      ],
      "source_keys": {
        "current": [
          "hindsight_plugin",
          "sha"
        ]
      }
    },
    {
      "name": "plugin:hermes_otel",
      "kind": "hermes-catalog",
      "roles": [
        "hermes-experiment"
      ],
      "inputs": [
        "sources.json"
      ],
      "catalog": "hermes_otel",
      "repository": "briancaffey/hermes-otel",
      "subdir": "hermes_otel",
      "parts": [
        "hermes-experiment/official-plugins"
      ],
      "source_keys": {
        "current": [
          "hermes_otel_plugin",
          "sha"
        ]
      }
    },
    {
      "name": "plugin:rea",
      "kind": "hermes-catalog",
      "roles": [
        "hermes-experiment"
      ],
      "inputs": [
        "sources.json"
      ],
      "catalog": "rea",
      "repository": "NousResearch/hermes-official-plugins",
      "subdir": "rea",
      "parts": [
        "hermes-experiment/official-plugins"
      ],
      "source_keys": {
        "current": [
          "rea_plugin",
          "sha"
        ]
      }
    },
    {
