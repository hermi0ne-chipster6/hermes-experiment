      ],
      "inputs": [
        "sources.json",
        "deployment/b/opensandbox.toml.example"
      ],
      "image": "opensandbox/code-interpreter",
      "source_keys": {
        "current": [
          "images",
          "opensandbox/code-interpreter",
          "tag"
        ],
        "digest": [
          "images",
          "opensandbox/code-interpreter",
          "index_digest"
        ],
        "amd64_digest": [
          "images",
          "opensandbox/code-interpreter",
          "amd64_digest"
        ]
      }
    },
    {
      "name": "image:opensandbox/execd",
      "kind": "docker-image",
      "roles": [
        "hermes-execution"
      ],
      "inputs": [
        "sources.json",
        "deployment/b/opensandbox.toml.example"
      ],
      "image": "opensandbox/execd",
      "source_keys": {
        "current": [
