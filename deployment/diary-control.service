[Unit]
Description=Hermes operator-only heartbeat metadata listener
Requires=diary-writer.service
After=diary-writer.service

[Service]
User=hermes-journal
Group=hermes-journal
WorkingDirectory=/opt/hermes-experiment/diary
ExecStartPre=/usr/bin/rm -f /run/hermes-diary/control.sock
ExecStart=/usr/bin/python3 -m hermes_diary --socket /run/hermes-diary/control.sock serve --database /var/lib/hermes-diary/journal.sqlite3 --operator-uid 0 --mode 0600
ReadWritePaths=/run/hermes-diary /var/lib/hermes-diary
UMask=0077
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
