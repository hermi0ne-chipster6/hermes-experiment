# Persistent operator profile. Empty MCP allowlists remain pending integration testing.
_config_version: 12
plugins:
  enabled:
  - hermes_diary
  - hermes_notifications
  - hermes_otel
  - hindsight
  - rea
memory:
  provider: hindsight
agent:
  disabled_toolsets: []
platform_toolsets:
  cli:
  - hermes-cli
  - hermes_diary
  - hermes_notifications
  - mcp-opensandbox
  - mcp-rea
  - mcp-link
  buzz:
  - memory
  - todo
  - session_search
  - cronjob
  - clarify
  - hermes_diary
  - hermes_notifications
  - mcp-opensandbox
  - mcp-rea
  - mcp-link
  email:
  - memory
  - todo
  - session_search
  - cronjob
  - clarify
  - hermes_diary
  - hermes_notifications
  - mcp-opensandbox
  - mcp-rea
  - mcp-link
  cron:
  - memory
  - todo
  - session_search
  - cronjob
  - clarify
  - hermes_diary
  - hermes_notifications
  - mcp-opensandbox
  - mcp-rea
  - mcp-link
platforms:
  buzz:
    enabled: false
  email:
    enabled: false
mcp_servers:
  opensandbox:
    command: /usr/local/bin/opensandbox-mcp
    args:
    - --use-server-proxy
    tools:
      include: []
  rea:
    command: /usr/local/bin/hermes-rea-remote
    args: []
    tools:
      include: []
  link:
    command: /usr/local/bin/link-cli
    args:
    - --mcp
    tools:
      include: []
terminal:
  cwd: /project
