#!/bin/bash
set -euo pipefail
result=0
timeout 2 "$SDK/node/bin/node" -e 'process.exit(require(process.argv[1]).version === "6.7.0" ? 0 : 1)' \
    "$SDK/rea/node_modules/rea-agents/package.json" >/dev/null 2>&1 || result=$?
case "$result" in
    0) ;;
    124) workshopctl set-health waiting 'REA installation probe warming'; exit 0 ;;
    *) workshopctl set-health error 'Pinned REA runtime/package probe failed'; exit 1 ;;
esac
result=0
timeout 1 sshd -t >/dev/null 2>&1 || result=$?
case "$result" in
    0) ;;
    124) workshopctl set-health waiting 'SSH configuration probe warming'; exit 0 ;;
    *) workshopctl set-health error 'Restricted SSH configuration is invalid'; exit 1 ;;
esac
workshopctl set-health okay
