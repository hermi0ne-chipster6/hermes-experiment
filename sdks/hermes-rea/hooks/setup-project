#!/bin/bash
set -euo pipefail
# The mount is connected after setup-base and may replace the initial directory.
# Restore normal writable-home semantics, including new provider directories
# such as ADB's .android. Never follow worker-controlled child paths as root.
sudo install -d -o rea -g rea -m 700 /var/lib/hermes-rea
sudo -Hu rea install -d -m 700 /var/lib/hermes-rea/work /var/lib/hermes-rea/inbox
sudo -Hu rea install -d -m 700 /var/lib/hermes-rea/.cache /var/lib/hermes-rea/.config /var/lib/hermes-rea/.local /var/lib/hermes-rea/.rea /var/lib/hermes-rea/.ghidra /var/lib/hermes-rea/.java /var/lib/hermes-rea/.npm /var/lib/hermes-rea/.docker /var/lib/hermes-rea/.agentenv /var/lib/hermes-rea/.agent-env-sandboxes
sudo -Hu rea install -d -m 700 /var/lib/hermes-rea/.local/share/rizin/cutter/plugins/python
sudo -Hu rea install -m 644 "$SDK/rea/node_modules/rea-agents/bridge/cutter/rea_bridge.py" /var/lib/hermes-rea/.local/share/rizin/cutter/plugins/python/rea_bridge.py
# Bind-mounted files retain host-source ownership, so OpenSSH StrictModes may
# reject them. Import only this fixed public allowlist into a root-owned path.
sudo install -d -o root -g root -m 755 /etc/ssh/hermes-rea
if [[ -r /etc/hermes-experiment/rea_authorized_keys ]]; then
    options=$(findmnt --noheadings --output OPTIONS --target /etc/hermes-experiment/rea_authorized_keys)
    [[ ",$options," == *,ro,* ]] || { echo 'REA configuration mount must be read-only.' >&2; exit 1; }
    sudo install -o root -g root -m 644 /etc/hermes-experiment/rea_authorized_keys /etc/ssh/hermes-rea/authorized_keys
else
    sudo rm -f /etc/ssh/hermes-rea/authorized_keys
fi
# The native CLI imports the analysis stack and exceeds the five-second health
# budget on cold/contended machines. Prove real startup here without weakening
# the bounded check-health contract; no MCP connection or model call is made.
version=$(timeout 120 sudo -Hu rea /usr/local/bin/hermes-rea-stdio --version)
[[ "$version" == 6.9.0 ]] || { echo 'Pinned native REA CLI startup failed.' >&2; exit 1; }
