#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
eatmydata apt-get install ca-certificates openssh-server openjdk-25-jdk-headless \
    binutils gdb file python3 procps util-linux git adb tshark apparmor sigrok-cli libicu78 \
    libsigrokdecode4 libmagic1t64 liblzo2-2 libfontconfig1 e2fsprogs squashfs-tools 7zip unzip \
    xz-utils zstd lz4 cpio lzip lzop unar android-sdk-libsparse-utils \
    erofs-utils lziprecover partclone upx-ucl \
    libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 \
    libcairo2 libcups2t64 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 \
    libnspr4 libnss3 libpango-1.0-0 libgtk-3-0t64 libx11-6 libxcb1 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
    fonts-liberation fonts-noto-color-emoji xvfb xauth x11-utils dconf-cli \
    libopengl0 libegl1 libglx0 libgl1-mesa-dri libsm6 libice6 libxtst6
# Ubuntu confines TShark. Keep that profile enforced while permitting REA's
# inherited Node IPC and the declared artifact locations. Preserve local policy.
install -D -m 644 "$SDK/apparmor/tshark" /etc/apparmor.d/local/tshark.d/hermes-rea
touch /etc/apparmor.d/local/tshark
policy_include='include if exists <local/tshark.d/hermes-rea>'
if ! grep -Fxq "$policy_include" /etc/apparmor.d/local/tshark; then
    printf '\n%s\n' "$policy_include" >> /etc/apparmor.d/local/tshark
fi
if [[ -d /sys/kernel/security/apparmor ]]; then
    apparmor_parser -r /etc/apparmor.d/tshark
fi
# Unblob's 7-Zip adapter uses the traditional command name.
if ! command -v 7z >/dev/null 2>&1; then
    test -x /usr/bin/7zz
    ln -sf /usr/bin/7zz /usr/local/bin/7z
fi
if ! id rea >/dev/null 2>&1; then
    useradd --system --create-home --home-dir /var/lib/hermes-rea --shell /bin/sh rea
else
    # sshd invokes ForceCommand through the account shell with -c. A non-login
    # sh does not source a worker-controlled .bashrc before the fixed wrapper.
    usermod --shell /bin/sh rea
fi
# Canonical's docker-ce SDK supplies the owned local engine for desktop build
# computers. Give the worker access when that SDK precedes hermes-rea.
if getent group docker >/dev/null; then
    usermod -a -G docker rea
fi
# Providers and upstream setup commands create their own home directories.
# Only the fixed home itself is prepared as root; child paths are worker-owned.
install -d -o rea -g rea -m 700 /var/lib/hermes-rea
runuser -u rea -- install -d -m 700 /var/lib/hermes-rea/work /var/lib/hermes-rea/inbox
runuser -u rea -- install -d -m 700 /var/lib/hermes-rea/.cache /var/lib/hermes-rea/.config /var/lib/hermes-rea/.local /var/lib/hermes-rea/.rea /var/lib/hermes-rea/.ghidra /var/lib/hermes-rea/.java /var/lib/hermes-rea/.npm /var/lib/hermes-rea/.docker /var/lib/hermes-rea/.agentenv /var/lib/hermes-rea/.agent-env-sandboxes
runuser -u rea -- install -d -m 700 /var/lib/hermes-rea/.local/share/rizin/cutter/plugins/python
runuser -u rea -- install -m 644 "$SDK/rea/node_modules/rea-agents/bridge/cutter/rea_bridge.py" /var/lib/hermes-rea/.local/share/rizin/cutter/plugins/python/rea_bridge.py
install -d -m 755 /usr/local/lib/docker/cli-plugins
ln -sf "$SDK/providers/docker-cli-plugins/docker-buildx" /usr/local/lib/docker/cli-plugins/docker-buildx
ln -sf "$SDK/providers/docker-cli-plugins/docker-compose" /usr/local/lib/docker/cli-plugins/docker-compose
ln -sf "$SDK/wrappers/hermes-rea-stdio" /usr/local/bin/hermes-rea-stdio
ln -sf "$SDK/wrappers/rea" /usr/local/bin/rea
ln -sf "$SDK/wrappers/rea" /usr/local/bin/rea-agents
ln -sf "$SDK/wrappers/cutter" /usr/local/bin/cutter
install -D -m 644 "$SDK/ssh/rea.conf" /etc/ssh/sshd_config.d/60-hermes-rea.conf
sshd -t
systemctl reload ssh || true
