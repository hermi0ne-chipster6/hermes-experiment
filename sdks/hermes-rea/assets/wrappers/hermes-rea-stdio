#!/bin/bash
set -euo pipefail
# The SSH Match block supplies no untrusted arguments. --version is only a local health probe.
sdk_dir=$(dirname "$(dirname "$(readlink -f "$0")")")
if [[ $# -gt 0 && ( $# -ne 1 || "$1" != '--version' ) ]]; then
    echo 'Only fixed REA MCP stdio or a local version probe is supported.' >&2
    exit 64
fi
export PATH="$sdk_dir/node/bin:/usr/bin:/bin"
export GHIDRA_INSTALL_DIR="$sdk_dir/ghidra/ghidra_12.1.4_PUBLIC"
export REA_PWNTOOLS_PYTHON=/usr/bin/python3
export REA_GHIDRA_STARTUP_TIMEOUT_MS=900000
cd /var/lib/hermes-rea/work
if [[ "${1:-}" == '--version' ]]; then
    exec "$sdk_dir/node/bin/node" "$sdk_dir/rea/node_modules/rea-agents/scripts/rea.mjs" --version
fi
case "${SSH_ORIGINAL_COMMAND:-}" in
    ''|rea-mcp) ;;
    *)
        echo 'Only native REA MCP is supported.' >&2
        exit 64
        ;;
esac
exec "$sdk_dir/node/bin/node" "$sdk_dir/rea/node_modules/rea-agents/scripts/rea.mjs" mcp
