#!/bin/bash
# Start immutable source with the SDK interpreter and Hermes' packaged PM activation.
set -euo pipefail
sdk_dir=$(dirname "$(dirname "$(readlink -f "$0")")")
export HERMES_PYTHON_SRC_ROOT="$sdk_dir/hermes-src"
export HERMES_INSTALL_ROOT="$sdk_dir/hermes-src"
# The packaged dashboard serves its built assets from the immutable SDK.
export HERMES_WEB_DIST="${HERMES_WEB_DIST:-$sdk_dir/hermes-src/hermes_cli/web_dist}"
export HERMES_DIARY_PYTHON_PATH="$sdk_dir/diary"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$sdk_dir/hermes-src:$HERMES_DIARY_PYTHON_PATH"
unset PYTHONHOME
exec "$sdk_dir/bin/python" -P -B -c '
import os
import sys

# Upstream bootstrap takes a lease on its selected persistent PM generation,
# activates its site-packages before third-party imports, and sets child paths.
import hermes_bootstrap

# Hermes PM selects the active environment. Keep the immutable, hash-locked
# SDK installations available for bundled integrations after that selection.
# The selected dependency versions still win for both this process and children.
sdk = os.path.dirname(os.environ["HERMES_PYTHON_SRC_ROOT"])
python_version = f"python{sys.version_info.major}.{sys.version_info.minor}"
packaged = os.path.join(sdk, "lib", python_version, "site-packages")
paths = os.environ["PYTHONPATH"].split(os.pathsep)
for path in (os.environ.pop("HERMES_DIARY_PYTHON_PATH"), packaged):
    if os.path.isdir(path):
        if path not in sys.path:
            sys.path.append(path)
        if path not in paths:
            paths.append(path)
os.environ["PYTHONPATH"] = os.pathsep.join(paths)

from hermes_cli.main import main
sys.exit(main())
' "$@"
