#!/bin/bash
# Runtime secret delivery; never executed under hook xtrace.
set -euo pipefail
sdk_dir=$(dirname "$(dirname "$(readlink -f "$0")")")
unset HERMES_PROFILE HERMES_CONFIG HERMES_CONFIG_PATH HERMES_ENV HERMES_ENV_PATH HERMES_YOLO_MODE HERMES_ACCEPT_HOOKS
unset HERMES_WORKSHOP_VALIDATE_PROFILE
export HERMES_HOME=/home/workshop/.hermes
export HERMES_RUNTIME_DIR="$HERMES_HOME/tools"
export npm_config_cache="${npm_config_cache:-$HERMES_HOME/cache/npm}"

# Classify a copy of argv with the pinned CLI parser. Hermes receives argv
# unchanged, including its profile selector and any child-command arguments.
mode=$("$sdk_dir/bin/python" -I -B -c '
import sys

sys.path.insert(0, sys.argv[1])
from hermes_cli._parser import command_argv, scan_profile_flag

arguments = sys.argv[2:]
_, used, index = scan_profile_flag(arguments)
if index is not None:
    del arguments[index:index + used]
first = arguments[0] if arguments else ""
if first in ("--version", "-V", "--help", "-h", "help"):
    print("offline")
elif command_argv(arguments)[:1] == ["update"]:
    print("update")
elif first == "send":
    print("send")
else:
    print("runtime")
' "$sdk_dir/hermes-src" "$@")
case "$mode" in
    update)
        echo 'This packaged Hermes is managed by SDKcraft. Use workshop refresh with a verified SDK.' >&2
        exit 64
        ;;
    offline|send) ;;
    runtime)
        charter=/etc/hermes-experiment/original-charter.md
        if [[ ! -r "$charter" ]] || [[ "$(readlink -f /project/.hermes.md)" != "$charter" ]]; then
            echo 'Original governing charter context is required before agent execution.' >&2
            exit 78
        fi
        charter_hash=$(sha256sum "$charter")
        if [[ "${charter_hash%% *}" != fab40f6dc5d2416db23e43d83de97c3b59db52c3d2e7bf01c051a7d9bbefd897 ]]; then
            echo 'Charter differs from the approved original; reconcile under operator review.' >&2
            exit 78
        fi
        cd /project
        export HERMES_WORKSHOP_VALIDATE_PROFILE=1
        ;;
esac
export HERMES_DIARY_SOCKET="${HERMES_DIARY_SOCKET:-/run/user/1000/hermes-diary.sock}"
# Use the bundled Node for the prebuilt TUI without provisioning another runtime.
export HERMES_NODE="${HERMES_NODE:-$sdk_dir/node/bin/node}"
export PATH="$sdk_dir/node/bin:$sdk_dir/buzz/bin:$PATH"
case "$mode" in
    offline) ;;
    *)
        # An explicitly supplied variable wins. Failed retrieval never exports
        # an empty value or changes the native application's authentication policy.
        for pair in 'BUZZ_PRIVATE_KEY:buzz-key' 'EMAIL_PASSWORD:email-password'; do
            variable=${pair%%:*}
            plug=${pair#*:}
            if [[ -z "${!variable:-}" ]]; then
                if value=$(workshopctl get-secret "hermes-experiment.$plug" 2>/dev/null) && [[ -n "$value" ]]; then
                    export "$variable=$value"
                fi
                unset value
            fi
        done
        if [[ -z "${OPEN_SANDBOX_API_KEY:-}" ]]; then
            if value=$(workshopctl get-secret hermes-experiment.sandbox-api-key 2>/dev/null) && [[ -n "$value" ]]; then
                export OPEN_SANDBOX_API_KEY="$value"
            fi
            unset value
        fi
        case "${HERMES_PROVIDER_KEY_ENV:-}" in
            ANTHROPIC_API_KEY|OPENAI_API_KEY|OPENROUTER_API_KEY|NOUS_API_KEY)
                variable=$HERMES_PROVIDER_KEY_ENV
                if [[ -z "${!variable:-}" ]]; then
                    if value=$(workshopctl get-secret hermes-experiment.model-key 2>/dev/null) && [[ -n "$value" ]]; then
                        export "$variable=$value"
                    fi
                    unset value
                fi
                ;;
        esac
        ;;
esac
exec "$sdk_dir/bin/hermes" "$@"
