#!/bin/bash
# Runtime secret delivery; never executed under hook xtrace.
set -euo pipefail
sdk_dir=$(dirname "$(dirname "$(readlink -f "$0")")")
# Native --profile is consumed before argparse, so reject it before exemptions
# such as send; otherwise it can redirect the dedicated configuration/identity.
for argument in "$@"; do
    case "$argument" in
        --) break ;;
        --profile|--profile=*|-p|-p?*)
            echo 'This runtime uses the fixed operator-managed Hermes profile.' >&2
            exit 64 ;;
    esac
done
unset HERMES_PROFILE HERMES_CONFIG HERMES_CONFIG_PATH HERMES_ENV HERMES_ENV_PATH HERMES_YOLO_MODE HERMES_ACCEPT_HOOKS
export HERMES_HOME=/home/workshop/.hermes
case "${1:-}" in
    update)
        echo 'This packaged Hermes is immutable. Promote a tested SDK, then use workshop refresh.' >&2
        exit 64
        ;;
    plugins)
        case "${2:-}" in
            install|update|remove)
                echo 'Plugin changes belong in a reviewed SDK build.' >&2
                exit 64
                ;;
        esac
        ;;
esac
case "${1:-}" in
    --version|-V|--help|-h|help|send) ;;
    *)
        config=/etc/hermes-experiment/config.yaml
        if [[ ! -r "$config" ]] || \
           [[ "$(readlink -f /home/workshop/.hermes/config.yaml)" != "$config" ]]; then
            echo 'Reviewed operator configuration is required; refusing local execution defaults.' >&2
            exit 78
        fi
        mount_options=$(findmnt --noheadings --output OPTIONS --target "$config")
        if [[ ",$mount_options," != *,ro,* ]]; then
            echo 'Operator configuration must come from the read-only mount.' >&2
            exit 78
        fi
        mode=$(stat -c %a "$config")
        if (( (8#$mode & 8#022) != 0 )); then
            echo 'Operator configuration must not be group/world writable.' >&2
            exit 78
        fi
        charter=/etc/hermes-experiment/original-charter.md
        if [[ ! -r "$charter" ]] || [[ "$(readlink -f /project/.hermes.md)" != "$charter" ]]; then
            echo 'Original governing charter context is required before agent execution.' >&2
            exit 78
        fi
        charter_hash=$(sha256sum "$charter")
        if [[ "${charter_hash%% *}" != fab40f6dc5d2416db23e43d83de97c3b59db52c3d2e7bf01c051a7d9bbefd897 ]]; then
            echo 'Charter differs from the approved original; reconcile under operator review.' >&2
            exit 78
        fi
        for argument in "$@"; do
            case "$argument" in
                --ignore-user-config|--ignore-rules|--in|--in=*|--safe-mode|--yolo|--accept-hooks|--toolsets|--toolsets=*|-t|-z)
                    echo 'This launch override is unavailable in the restricted runtime.' >&2
                    exit 64 ;;
            esac
        done
        if [[ "${1:-}" == --oneshot ]]; then
            echo 'Use native chat --oneshot; top-level one-shot bypasses approvals.' >&2
            exit 64
        fi
        "$sdk_dir/bin/python" "$sdk_dir/wrappers/check-configuration.py" "$config"
        cd /project
        ;;
esac
export HERMES_DIARY_SOCKET="${HERMES_DIARY_SOCKET:-/run/user/1000/hermes-diary.sock}"
export PATH="$sdk_dir/node/bin:$sdk_dir/buzz/bin:$PATH"
case "${1:-}" in
    --version|-V|--help|-h|help) ;;
    *)
        # An explicitly supplied variable wins. Failed retrieval never exports
        # an empty value or changes the native application's authentication policy.
        for pair in 'BUZZ_PRIVATE_KEY:buzz-key' 'EMAIL_PASSWORD:email-password'; do
            variable=${pair%%:*}
            plug=${pair#*:}
            if [[ -z "${!variable:-}" ]]; then
                if value=$(workshopctl get-secret "hermes-experiment.$plug" 2>/dev/null) && [[ -n "$value" ]]; then
                    export "$variable=$value"
                fi
                unset value
            fi
        done
        if [[ -z "${OPEN_SANDBOX_API_KEY:-}" ]]; then
            if value=$(workshopctl get-secret hermes-experiment.sandbox-api-key 2>/dev/null) && [[ -n "$value" ]]; then
                export OPEN_SANDBOX_API_KEY="$value"
            fi
            unset value
        fi
        case "${HERMES_PROVIDER_KEY_ENV:-}" in
            ANTHROPIC_API_KEY|OPENAI_API_KEY|OPENROUTER_API_KEY|NOUS_API_KEY)
                variable=$HERMES_PROVIDER_KEY_ENV
                if [[ -z "${!variable:-}" ]]; then
                    if value=$(workshopctl get-secret hermes-experiment.model-key 2>/dev/null) && [[ -n "$value" ]]; then
                        export "$variable=$value"
                    fi
                    unset value
                fi
                ;;
        esac
        ;;
esac
exec "$sdk_dir/bin/hermes" "$@"
