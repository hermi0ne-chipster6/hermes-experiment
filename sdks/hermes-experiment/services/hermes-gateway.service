[Unit]
Description=Hermes Experiment messaging gateway
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/hermes-experiment/gateway.enabled

[Service]
Type=simple
WorkingDirectory=/project
EnvironmentFile=-/etc/hermes-experiment/gateway.env
ExecStart=/usr/local/bin/hermes gateway run
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
