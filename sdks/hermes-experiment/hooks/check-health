#!/bin/bash
set -euo pipefail
if timeout 3 "$SDK/bin/python" -I -c 'import json,sys; assert sys.version_info[:3] == (3,14,7); stamp=json.load(open(sys.argv[1])); assert stamp["commit"] == "bf0203a794a07aac3ff764972ab9087baa4e4f4e" and stamp["baseVersion"] == "0.22.5"' "$SDK/hermes-src/install-stamp.json" >/dev/null 2>&1; then
    :
else
    status=$?
    if [[ $status -eq 124 ]]; then
        workshopctl set-health waiting "Hermes installation probe warming"
        exit 0
    fi
    workshopctl set-health error 'Pinned Hermes Python runtime probe failed'
    exit 1
fi
if [[ -f /etc/hermes-experiment/gateway.enabled ]] && ! systemctl --user --machine=workshop@.host is-active --quiet hermes-gateway.service; then
    workshopctl set-health waiting "Configured Hermes gateway is not active"
    exit 0
fi
workshopctl set-health okay
