[Unit]
Description=Hermes separate OpenSandbox execution service
After=network-online.target
ConditionPathExists=/etc/hermes-experiment/execution.enabled

[Service]
Type=simple
ExecStart=/usr/local/bin/hermes-opensandbox
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
