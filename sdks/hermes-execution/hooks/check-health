#!/bin/bash
set -euo pipefail
result=0
timeout 2 "$SDK/bin/python" -c 'from importlib.metadata import version; assert version("opensandbox-server") == "1.2.0"' >/dev/null 2>&1 || result=$?
case "$result" in
    0) ;;
    124) workshopctl set-health waiting 'OpenSandbox installation probe warming'; exit 0 ;;
    *) workshopctl set-health error 'Pinned OpenSandbox distribution cannot be loaded'; exit 1 ;;
esac
if [[ -f /etc/hermes-experiment/execution.enabled ]] && ! curl --silent --fail --max-time 1 http://127.0.0.1:8080/health >/dev/null; then
    workshopctl set-health waiting 'Configured OpenSandbox API is not healthy yet'
    exit 0
fi
workshopctl set-health okay
